rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /attendance/{docId} { allow read, write: if true; }
    match /classes/{className} { allow read, write: if true; }
    match /qr/{className} { allow read, write: if true; }

    // 매뉴얼 앱: 진도 기록
    match /progress/{doc} { allow read, write: if true; }

    // 매뉴얼 앱: 익명 질문
    match /asks/{doc} { allow read, write: if true; }

    // 매뉴얼 앱: 스크린샷 (base64 저장, 문서 1MB 제한)
    match /images/{doc} {
      allow read: if true;
      allow write: if request.resource.data.data is string
                   && request.resource.data.data.size() < 900000;
      allow delete: if true;
    }

    // 발표 자료 앱: 슬라이드 사진 (base64 저장, 문서 1MB 제한)
    match /talkImages/{doc} {
      allow read: if true;
      allow write: if request.resource.data.data is string
                   && request.resource.data.data.size() < 900000;
      allow delete: if true;
    }

    // 발표 자료 앱: 익명 접속 기록
    match /talkSessions/{doc} { allow read, write: if true; }

    // ===== 만점 다이어리 (윤사 /idea, 생윤 /app) =====
    // 두 앱 모두 같은 관리자 계정을 쓴다
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email == 'anstjsdud@sen.go.kr';
    }

    // ----- 윤사 만점 다이어리 -----
    match /yunsa_questions/{id} { allow read: if true; allow write: if isTeacher(); }
    match /yunsa_rates/{id} { allow read: if true; allow write: if isTeacher(); }
    match /yunsa_logs/{id} { allow create: if true; allow read, delete: if isTeacher(); }
    match /yunsa_reports/{id} { allow create: if true; allow read, update, delete: if isTeacher(); }

    match /yunsa_meta/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /yunsa_compare/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /yunsa_visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['d','h','dev','os','br','w','vid']);
      allow read, delete: if isTeacher();
    }

    match /yunsa_flags/{qid} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['at']);
      allow delete: if isTeacher();
    }

    match /yunsa_ids/{sid} {
      allow get: if true;
      allow create: if sid.matches('^[0-9]{5}$');
      allow list, delete: if isTeacher();
    }

    match /yunsa_learners/{key} {
      allow get: if true;
      allow create: if isTeacher() || (
        key.size() == 64
        && request.resource.data.studentId.matches('^[0-9]{5}$')
        && request.resource.data.nickname.size() <= 5
        && exists(/databases/$(database)/documents/yunsa_ids/$(request.resource.data.studentId))
      );
      allow update: if request.resource.data.studentId == resource.data.studentId
        && request.resource.data.nickname == resource.data.nickname;
      allow list, delete: if isTeacher();
    }

    // ----- 생윤 만점 다이어리 (윤사와 같은 구조, 컬렉션만 분리) -----
    match /saengyun_questions/{id} { allow read: if true; allow write: if isTeacher(); }
    match /saengyun_rates/{id} { allow read: if true; allow write: if isTeacher(); }
    match /saengyun_logs/{id} { allow create: if true; allow read, delete: if isTeacher(); }
    match /saengyun_reports/{id} { allow create: if true; allow read, update, delete: if isTeacher(); }

    match /saengyun_meta/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /saengyun_compare/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    match /saengyun_visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['d','h','dev','os','br','w','vid']);
      allow read, delete: if isTeacher();
    }

    match /saengyun_flags/{qid} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['at']);
      allow delete: if isTeacher();
    }

    match /saengyun_ids/{sid} {
      allow get: if true;
      allow create: if sid.matches('^[0-9]{5}$');
      allow list, delete: if isTeacher();
    }

    match /saengyun_learners/{key} {
      allow get: if true;
      allow create: if isTeacher() || (
        key.size() == 64
        && request.resource.data.studentId.matches('^[0-9]{5}$')
        && request.resource.data.nickname.size() <= 5
        && exists(/databases/$(database)/documents/saengyun_ids/$(request.resource.data.studentId))
      );
      allow update: if request.resource.data.studentId == resource.data.studentId
        && request.resource.data.nickname == resource.data.nickname;
      allow list, delete: if isTeacher();
    }

    // ===== moontr.site 대문 시간표 =====
    match /moontr_config/{id} {
      allow read: if true;
      allow write: if isTeacher();
    }

    // ===== 모든 웹앱 방문 수 (/visit.js) =====
    // 문서 이름: "앱이름__total"(누적) · "앱이름__d2026-09-25"(그날), 숫자 n 하나만
    // 누구나 보기, 누구나 1씩 올리기만 (처음 만들 때는 1), 관리자는 숫자를 맞추거나 지우기
    match /site_counts/{id} {
      allow read: if true;
      allow create: if id.matches('^[a-z0-9_-]+__(total|d[0-9]{4}-[0-9]{2}-[0-9]{2})$')
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
      allow write: if isTeacher();
    }

    // ===== 진선 50주년 기념 웹앱 =====
    // 메뉴 안내글: 누구나 보기, 관리자만 쓰기
    match /jinsun50_menus/{menuId} {
      allow read: if true;
      allow write: if isTeacher()
        && request.resource.data.body is string
        && request.resource.data.body.size() < 20000;
    }

    // 후원금 전광판: 누구나 보기, 관리자만 추가·수정·삭제 (메모는 선택, 30자 이내)
    match /jinsun50_donations/{id} {
      allow read: if true;
      allow create, update: if isTeacher()
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.amount is int
        && request.resource.data.amount > 0
        && (!('memo' in request.resource.data)
            || (request.resource.data.memo is string
                && request.resource.data.memo.size() <= 30));
      allow delete: if isTeacher();
    }

    // 후원자 실명: 관리자만 읽기·쓰기 (전광판에는 공개되지 않음)
    match /jinsun50_donors_private/{id} {
      allow read, delete: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.realName is string
        && request.resource.data.realName.size() <= 20;
    }

    // 사이트 설정 (기본 디자인·글꼴·후원 계좌): 누구나 보기, 관리자만 저장
    match /jinsun50_settings/{docId} {
      allow read: if true;
      allow write: if isTeacher()
        && (!('theme' in request.resource.data)
            || request.resource.data.theme in ['navy', 'lotus', 'night', 'album'])
        && (!('font' in request.resource.data)
            || request.resource.data.font in ['batang', 'jua', 'blackhan', 'yuntaeng'])
        && (!('account' in request.resource.data)
            || request.resource.data.account == null
            || request.resource.data.account is map);
    }

    // 익명 방문 기록: 누구나 남기기(정해진 항목만), 관리자만 보기·지우기
    match /jinsun50_visits/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(
          ['vid','dev','os','br','w','d','h','startMs','lastMs','dur','menus','opens','secs','ref'])
        && request.resource.data.dur is int
        && request.resource.data.dur >= 0
        && request.resource.data.dur < 86400;
      allow read, delete: if isTeacher();
    }

    // 첫 화면 방문자 수 (오늘 d2026-09-23 · 누적 total): 누구나 보기, 숫자는 1씩 올리기만
    match /jinsun50_counts/{id} {
      allow read: if true;
      allow create: if (id == 'total' || id.matches('^d[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1;
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
      allow delete: if isTeacher();
    }

    // 축하 방명록: 누구나 쓰기(승인 전 상태로만), 승인된 글만 공개, 관리자만 승인·삭제
    match /jinsun50_guestbook/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','msg','createdAtMs','approved'])
        && request.resource.data.approved == false
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.msg is string
        && request.resource.data.msg.size() > 0 && request.resource.data.msg.size() <= 300
        && request.resource.data.createdAtMs is int;
      allow read: if resource.data.approved == true || isTeacher();
      allow update, delete: if isTeacher();
    }

    // 추억 갤러리: 누구나 보기, 관리자만 올리기 (작은 사진 / 큰 사진 따로 저장)
    match /jinsun50_gallery/{id} {
      allow read: if true;
      allow create, update: if isTeacher()
        && request.resource.data.thumb is string
        && request.resource.data.thumb.size() < 200000;
      allow delete: if isTeacher();
    }
    // 추억 갤러리 사진별 조회수 (문서 이름 = 사진 id): 누구나 보기, 숫자는 1씩 올리기만, 있는 사진에만
    match /jinsun50_gallery_views/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == 1
        && exists(/databases/$(database)/documents/jinsun50_gallery/$(id));
      allow update: if request.resource.data.keys().hasOnly(['n'])
        && request.resource.data.n == resource.data.n + 1;
      allow delete: if isTeacher();
    }
    match /jinsun50_gallery_full/{id} {
      allow read: if true;
      allow create, update: if isTeacher()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow delete: if isTeacher();
    }

    // 사진 제보: 누구나 보내기(정해진 항목·크기만), 관리자만 보기·게시·삭제
    // 사진 연도(year)는 비워 두거나 1900~2100 숫자, 메모(memo)는 200자 이내
    match /jinsun50_submissions/{id} {
      allow create: if request.resource.data.keys().hasOnly(['thumb','year','caption','memo','by','createdAtMs'])
        && request.resource.data.thumb is string && request.resource.data.thumb.size() < 200000
        && (request.resource.data.year == null
            || (request.resource.data.year is int
                && request.resource.data.year >= 1900 && request.resource.data.year <= 2100))
        && request.resource.data.caption is string && request.resource.data.caption.size() <= 60
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 200
        && request.resource.data.by is string && request.resource.data.by.size() <= 20
        && request.resource.data.createdAtMs is int;
      allow read, delete: if isTeacher();
    }
    match /jinsun50_submissions_full/{id} {
      allow create: if request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow read, delete: if isTeacher();
    }

    // ===== 50주년 해외연수 (jinseon50th.com/gt) =====
    // 설정・카테고리・항목・메모: 누구나 보기, 관리자만 쓰기
    match /gt_settings/{id}   { allow read: if true; allow write: if isTeacher(); }
    match /gt_categories/{id} { allow read: if true; allow write: if isTeacher(); }
    match /gt_items/{id}      { allow read: if true; allow write: if isTeacher(); }
    match /gt_memos/{id}      { allow read: if true; allow write: if isTeacher(); }

    // 익명 접속 기록 (종류・카테고리명・시각만): 누구나 남기기(정해진 항목만), 관리자만 보기・지우기
    match /gt_logs/{id} {
      allow create: if request.resource.data.keys().hasOnly(['type', 'category', 'at'])
        && request.resource.data.type in ['visit', 'open']
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 100
        && request.resource.data.at == request.time;
      allow read, delete: if isTeacher();
    }

    // 명단 전체 이름: 관리자만 읽기・쓰기 (공개 명단 gt_items 에는 가린 이름만 저장)
    match /gt_people_private/{id} {
      allow read, delete: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20;
    }

    // ===== 바이브코딩 수업 (stuvibe) =====
    // 화면에는 학번·이름 대신 '학생 A'처럼 제출 순서로만 보이고,
    // 학번·이름은 vibe_plan_keys / vibe_fb_who 에만 저장 (목록 보기는 관리자만)
    function vibeText(d, k, minLen, maxLen) {
      return d[k] is string && d[k].size() >= minLen && d[k].size() <= maxLen;
    }
    function vibeStudent(d) {
      return d.sid is string && d.sid.matches('^[0-9]{5}$')
        && d.name is string && d.name.matches('^[^ ]{2}$');
    }

    // 계획서 내용: 누구나 보기(학번·이름 없음), 정해진 항목만 쓰기, 관리자만 지우기
    match /vibe_plans/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['ban','appName','problem','features','look','prompt','createdAt','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && vibeText(request.resource.data, 'appName', 1, 100)
        && vibeText(request.resource.data, 'problem', 1, 2000)
        && vibeText(request.resource.data, 'features', 1, 2000)
        && vibeText(request.resource.data, 'look', 1, 2000)
        && vibeText(request.resource.data, 'prompt', 1, 2000)
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow delete: if isTeacher();
    }

    // 제출한 학생: 문서 이름 = 반·학번·이름의 해시(64자리)
    // 학번과 이름을 모두 알아야 하나만 찾을 수 있음(다시 제출할 때), 목록은 관리자만
    match /vibe_plan_keys/{key} {
      allow get: if true;
      allow create: if key.size() == 64
        && request.resource.data.keys().hasOnly(['planId','ban','sid','name'])
        && request.resource.data.ban in ['A', 'B']
        && vibeStudent(request.resource.data)
        && request.resource.data.planId is string
        && existsAfter(/databases/$(database)/documents/vibe_plans/$(request.resource.data.planId));
      allow list, delete: if isTeacher();
    }

    // 친구 피드백 내용: 누구나 보기(쓴 사람은 '학생 ○'·'친구'로만 표시), 관리자만 지우기
    match /vibe_feedback/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['planId','ban','fromPlan','good','question','idea','createdAt','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && request.resource.data.planId is string
        && exists(/databases/$(database)/documents/vibe_plans/$(request.resource.data.planId))
        && vibeText(request.resource.data, 'fromPlan', 0, 40)
        && vibeText(request.resource.data, 'good', 1, 1000)
        && vibeText(request.resource.data, 'question', 0, 1000)
        && vibeText(request.resource.data, 'idea', 0, 1000)
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && existsAfter(/databases/$(database)/documents/vibe_fb_who/$(id));
      allow delete: if isTeacher();
    }

    // 피드백 쓴 학생의 학번·이름: 피드백과 함께만 만들기, 관리자만 보기·지우기
    match /vibe_fb_who/{id} {
      allow create: if request.resource.data.keys().hasOnly(['sid','name'])
        && vibeStudent(request.resource.data)
        && existsAfter(/databases/$(database)/documents/vibe_feedback/$(id));
      allow read, delete: if isTeacher();
    }

    // 수업 성찰: 문서 이름 = 반·학번·이름의 해시(64자리). 학번과 이름을 알아야 하나만 불러오기, 목록은 관리자만
    match /vibe_reflect/{key} {
      allow get: if true;
      allow create, update: if key.size() == 64
        && request.resource.data.keys().hasOnly(['ban','sid','name','appName','learned','felt','wonder','picks','final','createdAt','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && vibeStudent(request.resource.data)
        && vibeText(request.resource.data, 'appName', 0, 100)
        && vibeText(request.resource.data, 'learned', 0, 2000)
        && vibeText(request.resource.data, 'felt', 0, 2000)
        && vibeText(request.resource.data, 'wonder', 0, 2000)
        && vibeText(request.resource.data, 'picks', 0, 3000)
        && vibeText(request.resource.data, 'final', 1, 3000)
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow list, delete: if isTeacher();
    }

    // 문장 담벼락: 누구나 보기(이름 없이), 쓴 사람 학번·이름은 vibe_wall_who 에만(관리자만 보기)
    match /vibe_wall/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['ban','kind','text','createdAt'])
        && request.resource.data.ban in ['A', 'B']
        && request.resource.data.kind in ['learned', 'felt', 'wonder']
        && vibeText(request.resource.data, 'text', 1, 300)
        && request.resource.data.createdAt is int
        && existsAfter(/databases/$(database)/documents/vibe_wall_who/$(id));
      allow delete: if isTeacher();
    }
    match /vibe_wall_who/{id} {
      allow create: if request.resource.data.keys().hasOnly(['sid','name'])
        && vibeStudent(request.resource.data)
        && existsAfter(/databases/$(database)/documents/vibe_wall/$(id));
      allow read, delete: if isTeacher();
    }

    // 익명 접속 기록 (기기 종류·브라우저·날짜만): 누구나 남기기(정해진 항목만), 관리자만 보기·지우기
    match /stuvibe_visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['d','h','dev','os','br','w','vid']);
      allow read, delete: if isTeacher();
    }
    // 바이브코딩 실습편(/vibelab) 익명 접속 기록: 이론편과 같은 모양
    match /vibelab_visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['d','h','dev','os','br','w','vid']);
      allow read, delete: if isTeacher();
    }

    // ===== 바이브코딩 실습편 (vibelab) =====
    // 웹앱 이름·주소·소개: 누구나 보기(학번·이름 없음), 정해진 항목만 쓰기, 관리자만 지우기
    match /vibelab_apps/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['ban','appName','url','intro','ask','createdAt','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && vibeText(request.resource.data, 'appName', 1, 100)
        && vibeText(request.resource.data, 'url', 9, 300)
        && request.resource.data.url.matches('^https://[^ ]+
  }
}
)
        && vibeText(request.resource.data, 'intro', 0, 200)
        && vibeText(request.resource.data, 'ask', 0, 200)
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow delete: if isTeacher();
    }
    // 웹앱 올린 학생: 문서 이름 = 반·학번·이름의 해시(64자리). 하나만 찾기, 목록은 관리자만
    match /vibelab_app_keys/{key} {
      allow get: if true;
      allow create: if key.size() == 64
        && request.resource.data.keys().hasOnly(['appId','ban','sid','name'])
        && request.resource.data.ban in ['A', 'B']
        && vibeStudent(request.resource.data)
        && request.resource.data.appId is string
        && existsAfter(/databases/$(database)/documents/vibelab_apps/$(request.resource.data.appId));
      allow list, delete: if isTeacher();
    }
    // 웹앱 피드백: 누구나 보기(쓴 사람은 '학생 A'·'나'·'선생님'으로만 표시), 관리자만 지우기
    match /vibelab_checks/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['appId','ban','fromApp','good','bug','idea','createdAt'])
        && request.resource.data.ban in ['A', 'B']
        && request.resource.data.appId is string
        && exists(/databases/$(database)/documents/vibelab_apps/$(request.resource.data.appId))
        && vibeText(request.resource.data, 'fromApp', 0, 40)
        && (request.resource.data.fromApp != 'teacher' || isTeacher())
        && vibeText(request.resource.data, 'good', 0, 1000)
        && vibeText(request.resource.data, 'bug', 0, 1000)
        && vibeText(request.resource.data, 'idea', 0, 1000)
        && request.resource.data.good.size() + request.resource.data.bug.size() + request.resource.data.idea.size() > 0
        && request.resource.data.createdAt is int
        && existsAfter(/databases/$(database)/documents/vibelab_check_who/$(id));
      allow delete: if isTeacher();
    }
    // 피드백 쓴 사람의 학번·이름: 피드백과 함께만 만들기, 관리자만 보기·지우기
    match /vibelab_check_who/{id} {
      allow create: if request.resource.data.keys().hasOnly(['sid','name'])
        && vibeStudent(request.resource.data)
        && existsAfter(/databases/$(database)/documents/vibelab_checks/$(id));
      allow read, delete: if isTeacher();
    }
    // 수업 성찰: 문서 이름 = 반·학번·이름의 해시(64자리). 하나만 불러오기, 목록은 관리자만
    match /vibelab_reflect/{key} {
      allow get: if true;
      allow create, update: if key.size() == 64
        && request.resource.data.keys().hasOnly(['ban','sid','name','appName','url','learned','felt','wonder','picks','final','createdAt','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && vibeStudent(request.resource.data)
        && vibeText(request.resource.data, 'appName', 0, 100)
        && vibeText(request.resource.data, 'url', 0, 300)
        && vibeText(request.resource.data, 'learned', 0, 2000)
        && vibeText(request.resource.data, 'felt', 0, 2000)
        && vibeText(request.resource.data, 'wonder', 0, 2000)
        && vibeText(request.resource.data, 'picks', 0, 3000)
        && vibeText(request.resource.data, 'final', 1, 3000)
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow list, delete: if isTeacher();
    }
    // 문장 담벼락: 누구나 보기(이름 없이), 쓴 사람 학번·이름은 vibelab_wall_who 에만(관리자만 보기)
    match /vibelab_wall/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['ban','kind','text','createdAt'])
        && request.resource.data.ban in ['A', 'B']
        && request.resource.data.kind in ['learned', 'felt', 'wonder']
        && vibeText(request.resource.data, 'text', 1, 300)
        && request.resource.data.createdAt is int
        && existsAfter(/databases/$(database)/documents/vibelab_wall_who/$(id));
      allow delete: if isTeacher();
    }
    match /vibelab_wall_who/{id} {
      allow create: if request.resource.data.keys().hasOnly(['sid','name'])
        && vibeStudent(request.resource.data)
        && existsAfter(/databases/$(database)/documents/vibelab_wall/$(id));
      allow read, delete: if isTeacher();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
