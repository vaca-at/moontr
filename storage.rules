rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // 관리자 = 센메일 계정, 또는 구글 bellachord 계정 (구글이 확인한 메일만) — firestore.rules 와 같아요
    function isTeacher() {
      return request.auth != null
        && (request.auth.token.email == 'anstjsdud@sen.go.kr'
            || (request.auth.token.email == 'bellachord@gmail.com' && request.auth.token.email_verified == true));
    }

    // ===== AI Lab (/ailab) 캡쳐 원본 =====
    // 관리자만 올리기 · 보기 · 지우기. 사진(image/*)만, 한 장 10MB 미만. 올린 원본은 고치지 않아요
    match /ailab/captures/{file} {
      allow read, delete: if isTeacher();
      allow create: if isTeacher()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update: if false;
    }

    // ===== AI Lab 공문 묶음 (본문 + 첨부 PDF, 사진도 함께 가능) =====
    // ailab/bundles/{묶음 번호}/{1.pdf, 2.pdf ...}. 관리자만, PDF 또는 사진, 한 파일 20MB 미만
    match /ailab/bundles/{capId}/{file} {
      allow read, delete: if isTeacher();
      allow create: if isTeacher()
        && request.resource.size < 20 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
      allow update: if false;
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
