rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 연수용 프로젝트 (SONAGI): 소나기 연수 · stuvibe · vibelab =====
    // 관리자 계정 (Authentication 구글 로그인 · 서울시교육청 sen 메일 · 구글 메일)
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email in ['anstjsdud@sen.go.kr', 'bellachord@gmail.com'];
    }

    // ===== 바이브코딩 수업 (stuvibe) =====
    // 학생은 반 + 닉네임 + 숫자 네 자리로 들어와요. 네 자리는 저장하지 않고 해시(문서 이름)로만 써요.
    // 화면에는 닉네임 대신 '학생 A'처럼 제출 순서로만 보이고, 닉네임은 *_keys / *_who 에만 (목록 보기는 관리자만)
    function vibeText(d, k, minLen, maxLen) {
      return d[k] is string && d[k].size() >= minLen && d[k].size() <= maxLen;
    }
    function vibeStudent(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 10;
    }

    // 출석부 (이론편 · 실습편 관리자 대시보드): 학번 · 이름이 있어 관리자만 보기 · 쓰기
    match /vibe_roster/{id} {
      allow read, write: if isTeacher();
    }

    // 로그인 기록 (출석부 학번 · 이름 ↔ 학생 닉네임 연결): 문서 이름 = 강좌_반_학번
    // 학생은 자기 기록을 남기기만(정해진 항목만), 학번이 있어 보기 · 지우기는 관리자만
    match /vibe_checkin/{id} {
      allow create, update: if request.resource.data.keys().hasOnly(['course','ban','sid','name','at'])
        && request.resource.data.course in ['theory', 'lab']
        && request.resource.data.ban in ['A', 'B']
        && request.resource.data.sid is string && request.resource.data.sid.matches('^[0-9]{5}$')
        && id == request.resource.data.course + '_' + request.resource.data.ban + '_' + request.resource.data.sid
        && vibeStudent(request.resource.data)
        && request.resource.data.at is int;
      allow read, delete: if isTeacher();
    }

    // 💬 우리 반 채팅방: 누구나 보기(닉네임만), 정해진 항목만 쓰기, 선생님 글(t: true)은 관리자만, 지우기는 관리자만
    match /vibe_talk/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['course','ban','name','text','at','t'])
        && request.resource.data.course in ['theory', 'lab']
        && request.resource.data.ban in ['A', 'B']
        && vibeStudent(request.resource.data)
        && vibeText(request.resource.data, 'text', 1, 300)
        && request.resource.data.at is int
        && request.resource.data.t is bool
        && (request.resource.data.t == false || isTeacher());
      allow delete: if isTeacher();
    }

    // 🙋 선생님께 질문 (1:1): 문서 이름 = 강좌_해시(반 · 학번 · 닉네임을 알아야 열 수 있음), 목록 · 지우기는 관리자만
    match /vibe_ask/{id} {
      allow get: if true;
      allow list, delete: if isTeacher();
      allow create, update: if isTeacher() || (
        request.resource.data.keys().hasOnly(['course','ban','name','msgs','at','unread'])
        && request.resource.data.course in ['theory', 'lab']
        && request.resource.data.ban in ['A', 'B']
        && id.size() > 60
        && vibeStudent(request.resource.data)
        && request.resource.data.msgs is list && request.resource.data.msgs.size() <= 100
        && request.resource.data.at is int
        && request.resource.data.unread is bool);
    }

    // 계획서 내용: 누구나 보기(닉네임 없음), 정해진 항목만 쓰기, 관리자만 지우기
    match /vibe_plans/{id} {
      allow read: if true;
      // 6번 계획서(네 칸)와 9번 '내 계획서'(웹앱 내용 content · 웹앱 링크 url)를 함께 담아요. 한쪽만 써도 저장돼요
      allow create, update: if request.resource.data.keys().hasOnly(
          ['ban','appName','problem','features','look','prompt','content','url','createdAt','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && vibeText(request.resource.data, 'appName', 1, 100)
        && vibeText(request.resource.data, 'problem', 0, 2000)
        && vibeText(request.resource.data, 'features', 0, 2000)
        && vibeText(request.resource.data, 'look', 0, 2000)
        && vibeText(request.resource.data, 'prompt', 0, 2000)
        && (!('content' in request.resource.data) || vibeText(request.resource.data, 'content', 0, 3000))
        && (!('url' in request.resource.data) || (vibeText(request.resource.data, 'url', 0, 500)
            && (request.resource.data.url == '' || request.resource.data.url.matches('^https://[^ ]+$'))))
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow delete: if isTeacher();
    }

    // 제출한 학생: 문서 이름 = 반·닉네임·네 자리의 해시(64자리)
    // 닉네임과 네 자리를 모두 알아야 하나만 찾을 수 있음(다시 제출할 때), 목록은 관리자만
    match /vibe_plan_keys/{key} {
      allow get: if true;
      allow create: if key.size() == 64
        && request.resource.data.keys().hasOnly(['planId','ban','name'])
        && request.resource.data.ban in ['A', 'B']
        && vibeStudent(request.resource.data)
        && request.resource.data.planId is string
        && existsAfter(/databases/$(database)/documents/vibe_plans/$(request.resource.data.planId));
      allow list, delete: if isTeacher();
    }

    // 친구 피드백 내용: 누구나 보기(쓴 사람은 '학생 ○'·'친구'로만 표시), 관리자만 지우기
    match /vibe_feedback/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['planId','ban','fromPlan','good','question','idea','createdAt','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && request.resource.data.planId is string
        && exists(/databases/$(database)/documents/vibe_plans/$(request.resource.data.planId))
        && vibeText(request.resource.data, 'fromPlan', 0, 40)
        && vibeText(request.resource.data, 'good', 1, 1000)
        && vibeText(request.resource.data, 'question', 0, 1000)
        && vibeText(request.resource.data, 'idea', 0, 1000)
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int
        && existsAfter(/databases/$(database)/documents/vibe_fb_who/$(id));
      allow delete: if isTeacher();
    }

    // 계획서 미리보기: AI가 만든 index.html 코드 (문서 이름 = 계획서 번호). 누구나 보기,
    // 그 계획서가 있을 때만 쓰기(30만 글자까지), 관리자만 지우기
    match /vibe_preview/{planId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['ban','html','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && request.resource.data.html is string
        && request.resource.data.html.size() > 0 && request.resource.data.html.size() <= 300000
        && request.resource.data.updatedAt is int
        && exists(/databases/$(database)/documents/vibe_plans/$(planId));
      allow delete: if isTeacher();
    }

    // 피드백 쓴 학생의 닉네임: 피드백과 함께만 만들기, 관리자만 보기·지우기
    match /vibe_fb_who/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name'])
        && vibeStudent(request.resource.data)
        && existsAfter(/databases/$(database)/documents/vibe_feedback/$(id));
      allow read, delete: if isTeacher();
    }

    // 수업 성찰: 문서 이름 = 반·닉네임·네 자리의 해시(64자리). 닉네임과 네 자리를 알아야 하나만 불러오기, 목록은 관리자만
    match /vibe_reflect/{key} {
      allow get: if true;
      allow create, update: if key.size() == 64
        && request.resource.data.keys().hasOnly(['ban','name','appName','learned','felt','wonder','picks','aiDraft','final','createdAt','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && vibeStudent(request.resource.data)
        && vibeText(request.resource.data, 'appName', 0, 100)
        && vibeText(request.resource.data, 'learned', 0, 2000)
        && vibeText(request.resource.data, 'felt', 0, 2000)
        && vibeText(request.resource.data, 'wonder', 0, 2000)
        && vibeText(request.resource.data, 'picks', 0, 3000)
        && (!('aiDraft' in request.resource.data) || vibeText(request.resource.data, 'aiDraft', 0, 4000))
        && vibeText(request.resource.data, 'final', 0, 3000)
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow list, delete: if isTeacher();
    }

    // 문장 담벼락: 누구나 보기(이름 없이), 쓴 사람 닉네임은 vibe_wall_who 에만(관리자만 보기)
    match /vibe_wall/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['ban','kind','text','createdAt'])
        && request.resource.data.ban in ['A', 'B']
        && request.resource.data.kind in ['learned', 'felt', 'wonder']
        && vibeText(request.resource.data, 'text', 1, 300)
        && request.resource.data.createdAt is int
        && existsAfter(/databases/$(database)/documents/vibe_wall_who/$(id));
      allow delete: if isTeacher();
    }
    match /vibe_wall_who/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name'])
        && vibeStudent(request.resource.data)
        && existsAfter(/databases/$(database)/documents/vibe_wall/$(id));
      allow read, delete: if isTeacher();
    }

    // 익명 접속 기록 (기기 종류·브라우저·날짜만): 누구나 남기기(정해진 항목만), 관리자만 보기·지우기
    match /stuvibe_visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['d','h','dev','os','br','w','vid']);
      allow read, delete: if isTeacher();
    }
    // 바이브코딩 실습편(/vibelab) 익명 접속 기록: 이론편과 같은 모양
    match /vibelab_visits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['d','h','dev','os','br','w','vid']);
      allow read, delete: if isTeacher();
    }

    // ===== 바이브코딩 실습편 (vibelab) =====
    // 웹앱 이름·주소·소개: 누구나 보기(닉네임 없음), 정해진 항목만 쓰기, 관리자만 지우기
    match /vibelab_apps/{id} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(
          ['ban','appName','url','intro','ask','createdAt','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && vibeText(request.resource.data, 'appName', 1, 100)
        && vibeText(request.resource.data, 'url', 9, 300)
        && request.resource.data.url.matches('^https://[^ ]+$')
        && vibeText(request.resource.data, 'intro', 0, 200)
        && vibeText(request.resource.data, 'ask', 0, 200)
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow delete: if isTeacher();
    }
    // 웹앱 올린 학생: 문서 이름 = 반·닉네임·네 자리의 해시(64자리). 하나만 찾기, 목록은 관리자만
    match /vibelab_app_keys/{key} {
      allow get: if true;
      allow create: if key.size() == 64
        && request.resource.data.keys().hasOnly(['appId','ban','name'])
        && request.resource.data.ban in ['A', 'B']
        && vibeStudent(request.resource.data)
        && request.resource.data.appId is string
        && existsAfter(/databases/$(database)/documents/vibelab_apps/$(request.resource.data.appId));
      allow list, delete: if isTeacher();
    }
    // 웹앱 피드백: 누구나 보기(쓴 사람은 '학생 A'·'나'·'선생님'으로만 표시), 관리자만 지우기
    match /vibelab_checks/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
          ['appId','ban','fromApp','good','bug','idea','createdAt'])
        && request.resource.data.ban in ['A', 'B']
        && request.resource.data.appId is string
        && exists(/databases/$(database)/documents/vibelab_apps/$(request.resource.data.appId))
        && vibeText(request.resource.data, 'fromApp', 0, 40)
        && (request.resource.data.fromApp != 'teacher' || isTeacher())
        && vibeText(request.resource.data, 'good', 0, 1000)
        && vibeText(request.resource.data, 'bug', 0, 1000)
        && vibeText(request.resource.data, 'idea', 0, 1000)
        && request.resource.data.good.size() + request.resource.data.bug.size() + request.resource.data.idea.size() > 0
        && request.resource.data.createdAt is int
        && existsAfter(/databases/$(database)/documents/vibelab_check_who/$(id));
      allow delete: if isTeacher();
    }
    // 피드백 쓴 사람의 닉네임: 피드백과 함께만 만들기, 관리자만 보기·지우기
    match /vibelab_check_who/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name'])
        && vibeStudent(request.resource.data)
        && existsAfter(/databases/$(database)/documents/vibelab_checks/$(id));
      allow read, delete: if isTeacher();
    }
    // 수업 성찰: 문서 이름 = 반·닉네임·네 자리의 해시(64자리). 하나만 불러오기, 목록은 관리자만
    match /vibelab_reflect/{key} {
      allow get: if true;
      allow create, update: if key.size() == 64
        && request.resource.data.keys().hasOnly(['ban','name','appName','url','learned','felt','wonder','picks','aiDraft','final','createdAt','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && vibeStudent(request.resource.data)
        && vibeText(request.resource.data, 'appName', 0, 100)
        && vibeText(request.resource.data, 'url', 0, 300)
        && vibeText(request.resource.data, 'learned', 0, 2000)
        && vibeText(request.resource.data, 'felt', 0, 2000)
        && vibeText(request.resource.data, 'wonder', 0, 2000)
        && vibeText(request.resource.data, 'picks', 0, 3000)
        && (!('aiDraft' in request.resource.data) || vibeText(request.resource.data, 'aiDraft', 0, 4000))
        && vibeText(request.resource.data, 'final', 0, 3000)
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;
      allow list, delete: if isTeacher();
    }
    // 문장 담벼락: 누구나 보기(이름 없이), 쓴 사람 닉네임은 vibelab_wall_who 에만(관리자만 보기)
    match /vibelab_wall/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['ban','kind','text','createdAt'])
        && request.resource.data.ban in ['A', 'B']
        && request.resource.data.kind in ['learned', 'felt', 'wonder']
        && vibeText(request.resource.data, 'text', 1, 300)
        && request.resource.data.createdAt is int
        && existsAfter(/databases/$(database)/documents/vibelab_wall_who/$(id));
      allow delete: if isTeacher();
    }
    // 자기 점검 · AI 점검 뒤 고친 점: 문서 이름 = 반·닉네임·네 자리의 해시(64자리). 쓰기만, 보기는 관리자만
    match /vibelab_fix/{key} {
      allow create, update: if key.size() == 64
        && request.resource.data.keys().hasOnly(['ban','name','appName','selfSum','selfResult','selfFix','aiFix','updatedAt'])
        && request.resource.data.ban in ['A', 'B']
        && vibeStudent(request.resource.data)
        && vibeText(request.resource.data, 'appName', 0, 100)
        && vibeText(request.resource.data, 'selfSum', 0, 100)
        && vibeText(request.resource.data, 'selfResult', 0, 4000)
        && vibeText(request.resource.data, 'selfFix', 0, 1000)
        && vibeText(request.resource.data, 'aiFix', 0, 1000)
        && request.resource.data.updatedAt is int;
      allow read, delete: if isTeacher();
    }
    match /vibelab_wall_who/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name'])
        && vibeStudent(request.resource.data)
        && existsAfter(/databases/$(database)/documents/vibelab_wall/$(id));
      allow read, delete: if isTeacher();
    }

    // ===== 소나기 연수 실습 (/sonagi) 동료 검증 담벼락 =====
    // 로그인 없이 써요. 웹앱을 올릴 때 닉네임 + 숫자 네 자리를 정하고, 그 해시(pin, 64글자)만 저장해요.
    // 로그인이 없어 '내 것'을 규칙으로 완전히 잠글 수는 없어요 → 고칠 수 있는 칸을 좁히고, 아예 지우기는 관리자만
    function sonagiApp(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 20
        && d.title is string && d.title.size() > 0 && d.title.size() <= 40
        && d.url is string && d.url.size() <= 200 && d.url.matches('^https?://.+')
        && d.pin is string && d.pin.matches('^[0-9a-f]{64}$');
    }
    // 선생님 웹앱: 닉네임 · 웹앱 이름 · 주소 · pin(해시) · 의견 수
    match /sonagi_apps/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'title', 'url', 'pin', 'at', 'noteCount'])
        && sonagiApp(request.resource.data)
        && request.resource.data.noteCount == 0
        && request.resource.data.at == request.time;
      // 올린 선생님: 웹앱 이름 · 주소 고치기, 담벼락에서 내리기(gone) / 다른 선생님: 의견 수만 1 올리기
      allow update: if (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'url', 'gone'])
          && sonagiApp(request.resource.data)
          && (!('gone' in request.resource.data) || request.resource.data.gone == true))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['noteCount'])
          && request.resource.data.noteCount == resource.data.get('noteCount', 0) + 1);
      allow delete: if isTeacher();
    }
    // 동료 의견: 칭찬 한 가지(good) · 제안 한 가지(idea) — 화면에서는 웹앱을 올린 선생님에게만 보여 줘요
    match /sonagi_notes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['app', 'good', 'idea', 'by', 'at'])
        && request.resource.data.app is string && request.resource.data.app.size() <= 40
        && exists(/databases/$(database)/documents/sonagi_apps/$(request.resource.data.app))
        && request.resource.data.good is string && request.resource.data.good.size() <= 100
        && request.resource.data.idea is string && request.resource.data.idea.size() <= 100
        && (request.resource.data.good.size() > 0 || request.resource.data.idea.size() > 0)
        && request.resource.data.by is string && request.resource.data.by.size() <= 20
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isTeacher();
    }
    // 연수 소감 (6단계 ③ 마무리 · 소감 갤러리): 소감 글 · 닉네임 · pin(닉네임+네 자리 해시) · 시각, 누구나 보기
    // 고치기는 글(text)만 (닉네임 · pin은 못 바꿔요). 로그인이 없어 '내 것'을 규칙으로 완전히 잠글 수는 없어요 (웹앱과 같아요)
    // 예전 소감(이름 없이 글 · 시각만)도 그대로 읽혀요. 아예 지우기는 관리자만
    // 글자 수는 화면에서 제한하지 않아요. 규칙은 도배만 막도록 아주 넉넉하게 (5000자)
    function sonagiRfText(d) {
      return d.text is string && d.text.size() > 0 && d.text.size() <= 5000;
    }
    match /sonagi_reflect/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['text', 'name', 'pin', 'at'])
        && request.resource.data.keys().hasAll(['text', 'name', 'pin', 'at'])
        && sonagiRfText(request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.pin is string && request.resource.data.pin.matches('^[0-9a-f]{64}$')
        && request.resource.data.at == request.time;
      allow update: if 'pin' in resource.data
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
        && sonagiRfText(request.resource.data);
      allow delete: if isTeacher();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
